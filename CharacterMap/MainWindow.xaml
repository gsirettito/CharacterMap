<Window x:Class="CharacterMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CharacterMap"
        xmlns:virtual="clr-namespace:VirtualCollection.VirtualCollection"
        xmlns:fonts="clr-namespace:SiretT.Fonts"
        mc:Ignorable="d"
        Title="Character Map" Height="500" MinHeight="500" Width="900" MinWidth="900" WindowState="Maximized">
    <Window.Resources>
        <local:FamilyTypefaceToGlyphCountConverter x:Key="FamilyTypefaceToGlyphCountConverter"/>
        <local:FamilyTypefaceToStringConverter x:Key="FamilyTypefaceToStringConverter"/>
        <local:IsSymbolFontConverter x:Key="IsSymbolFontConverter"/>
        <local:WidthToColumnsConverter x:Key="WidthToColumnsConverter"/>
        <local:HeightToRowsConverter x:Key="HeightToRowsConverter"/>
        <Color x:Key="SelectedBackgroundColor">#FFC5CBF9</Color>
        <Color x:Key="SelectedUnfocusedColor">#FFDDDDDD</Color>

        <Color x:Key="ControlLightColor">White</Color>
        <Color x:Key="ControlMediumColor">#FF7381F9</Color>
        <Color x:Key="ControlDarkColor">#FF211AA9</Color>

        <Color x:Key="ControlMouseOverColor">#FF3843C4</Color>
        <Color x:Key="ControlPressedColor">#FF211AA9</Color>

        <!--Border colors-->
        <Color x:Key="BorderLightColor">#FFCCCCCC</Color>
        <Color x:Key="BorderMediumColor">#FF888888</Color>
        <Color x:Key="BorderDarkColor">#FF444444</Color>

        <Color x:Key="PressedBorderLightColor">#FF888888</Color>
        <Color x:Key="PressedBorderDarkColor">#FF444444</Color>

        <Color x:Key="DisabledBorderLightColor">#FFAAAAAA</Color>
        <Color x:Key="DisabledBorderDarkColor">#FF888888</Color>

        <Color x:Key="DefaultBorderBrushDarkColor">Black</Color>

    </Window.Resources>
    <Grid Margin="0 15 0 0">
        <DockPanel DataContext="{Binding ElementName=charListView, Path=SelectedValue}">
            <DockPanel DockPanel.Dock="Left" Width="256">
                <DockPanel DockPanel.Dock="Top">
                    <fonts:FontAwesomeIcon Icon="&#xE094;"
                                           Margin="3 0"
                                           FontPack="Fluent"
                                           DockPanel.Dock="Right"/>
                    <TextBox x:Name="filterBox"
                             Tag="Search ..."
                             Style="{DynamicResource SearchTextBox}" TextChanged="filterBox_TextChanged"/>
                </DockPanel>
                <ListBox x:Name="fontListBox"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         SelectionMode="Single"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         SelectionChanged="fontListBox_Selected" Tag="fontListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8 4" Height="40">
                                <TextBlock Text="{Binding Name}"
                                       FontSize="16"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"
                                       FontFamily="{Binding Converter={StaticResource IsSymbolFontConverter}}"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter ResizeBehavior="PreviousAndCurrent" Width="2" ResizeDirection="Columns"/>
            <DockPanel DockPanel.Dock="Right" Width="256"
                       DataContext="{Binding ElementName=charListView, Path=SelectedItem, Mode=OneWay}">
                <StackPanel DockPanel.Dock="Bottom" Margin="10">
                    <TextBlock FontSize="14"
                               FontFamily="Consolas"
                               Text="{Binding UnicodeHex}"/>
                    <TextBlock FontSize="14"
                               Margin="0 5 0 0"
                               ToolTip="Copy to clipboard"
                               FontFamily="Consolas">
                        <Hyperlink Click="Hyperlink_Click">
                            <Run Text="{Binding UnicodeValue, Mode=OneWay}"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock FontSize="14"
                               Margin="0 5 0 0"
                               ToolTip="Copy as Glyph code"
                               FontFamily="Consolas">
                        <Hyperlink Click="hypCopyGlyph_Click">Glyph code</Hyperlink>
                    </TextBlock>
                    <TextBlock FontSize="14"
                               Margin="0 5 0 0"
                               ToolTip="Copy as UTF-16 code"
                               FontFamily="Consolas">
                        <Hyperlink Click="hypCopyUTF16_Click">UTF-16 code</Hyperlink>
                    </TextBlock>
                    <TextBlock FontSize="14"
                               Margin="0 5 0 0"
                               ToolTip="Copy as SVG"
                               FontFamily="Consolas">
                        <Hyperlink Click="hypCopySVG_Click">Copy as SVG</Hyperlink>
                    </TextBlock>
                    <TextBlock FontSize="14"
                               Margin="0 5 0 0"
                               ToolTip="Copy as CSharp Data Geometry"
                               FontFamily="Consolas">
                        <Hyperlink Click="hypCopyData_Click">Copy as Data</Hyperlink>
                    </TextBlock>
                    <TextBox IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             Visibility="Collapsed"
                             FontFamily="Consolas"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="100"
                             Text="{Binding Data, Mode=OneWay}"/>

                </StackPanel>
                <Border Margin="10">
                    <Viewbox Stretch="Uniform">
                        <Viewbox Stretch="None">
                            <fonts:FontIcon Glyph="{Binding Character}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            FontFamily="{Binding FontName}"
                                            FontStretch="{Binding SelectedItem.Stretch, ElementName=typefacesCombo, Mode=OneWay}"
                                            FontStyle="{Binding SelectedItem.Style, ElementName=typefacesCombo, Mode=OneWay}"
                                            FontWeight="{Binding SelectedItem.Weight, ElementName=typefacesCombo, Mode=OneWay}"/>
                        </Viewbox>
                    </Viewbox>
                </Border>
            </DockPanel>
            <TextBox x:Name="textBox" DockPanel.Dock="Bottom" Height="115"
                     DataContext="{Binding ElementName=fontListBox, Path=SelectedItem, Mode=OneWay}"
                     BorderThickness="1"
                     BorderBrush="LightGray"
                     FontSize="48"
                     VerticalContentAlignment="Center"
                     FontFamily="{Binding Name}"
                     FontStretch="{Binding SelectedItem.Stretch, ElementName=typefacesCombo, Mode=OneWay}"
                     FontStyle="{Binding SelectedItem.Style, ElementName=typefacesCombo, Mode=OneWay}"
                     FontWeight="{Binding SelectedItem.Weight, ElementName=typefacesCombo, Mode=OneWay}"
                     Style="{DynamicResource StandardTextBox}"/>
            <DockPanel DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock Margin="20 0"
                               Text="{Binding ElementName=fontListBox, Path=SelectedItem.Name}"
                               FontSize="24"
                               FontWeight="Bold"/>
                    <TextBlock Margin="20 0"
                               FontSize="10">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource FamilyTypefaceToGlyphCountConverter}">
                                <Binding ElementName="typefacesCombo" Path="SelectedItem"/>
                                <Binding ElementName="fontListBox" Path="SelectedItem"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <StackPanel Margin="0 5 0 0" Orientation="Horizontal">
                        <ComboBox x:Name="typefacesCombo"
                                  Margin="20 0 0 0"
                                  HorizontalAlignment="Left"
                                  Width="160">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontStretch="{Binding Stretch}"
                                               FontStyle="{Binding Style}"
                                               FontWeight="{Binding Weight}"
                                               Text="{Binding Converter={StaticResource FamilyTypefaceToStringConverter}, Mode=OneWay}" MouseDown="TextBlock_MouseDown"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <DockPanel DockPanel.Dock="Top" Width="100">
                            <fonts:FontAwesomeIcon Icon="&#xE094;"
                                           Margin="3 0"
                                           FontPack="Fluent"
                                           DockPanel.Dock="Right"/>
                            <TextBox x:Name="charFilterBox"
                                     Tag="Search char..."
                                     Style="{DynamicResource SearchTextBox}" TextChanged="charFilterBox_TextChanged"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <ListView x:Name="charListView"
                      Margin="3"
                      BorderThickness="0"
                      ItemsSource="{Binding Items, Mode=OneWay}"
                      SelectedValue="{Binding SelectedItem, Mode=OneWay}"
                      PreviewKeyDown="charListView_PreviewKeyDown"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="False">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <virtual:UniformGridPanel Orientation="Vertical"
                                                  Rows="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource HeightToRowsConverter}}"
                                                  Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource WidthToColumnsConverter}}"
                                                  ScrollLength="500" UseLayoutRounding="True">
                        </virtual:UniformGridPanel>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray"
                                Background="Transparent"
                                MouseLeftButtonDown="charItem_MouseLeftButtonDown"
                                Width="82"
                                Height="82"
                                ClipToBounds="True"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderThickness="1" Padding="0"
                                ToolTip="{Binding UnicodeHex}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Border ClipToBounds="True">
                                    <Viewbox VerticalAlignment="Center"
                                             HorizontalAlignment="Center">
                                        <fonts:FontIcon Glyph="{Binding Character}"
                                                        FontFamily="{Binding FontName}"
                                                        FontStretch="{Binding SelectedItem.Stretch, ElementName=typefacesCombo, Mode=OneWay}"
                                                        FontStyle="{Binding SelectedItem.Style, ElementName=typefacesCombo, Mode=OneWay}"
                                                        FontWeight="{Binding SelectedItem.Weight, ElementName=typefacesCombo, Mode=OneWay}"
                                                        FontSize="48"/>
                                    </Viewbox>
                                </Border>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding UnicodeHex}"
                                           HorizontalAlignment="Center"
                                           Foreground="Gray"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>
    </Grid>
</Window>
